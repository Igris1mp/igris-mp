{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "igris-mp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4ead5bd5-ee64-4bfc-b64a-a4fd20203e0f","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "54e4f8a0896f4a5ba10f2a633bf47c4f" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
